{
	"$schema": "https://opencode.ai/config.json",
	"provider": {
		"llm": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "llm",
			"options": {
				"baseURL": "http://localhost:8090/v1",
				"apiKey": "{env:LLM_API_KEY}"
			},
			"models": {
				"gpt-5.4": {
					"limit": {
						"context": 1000000,
						"output": 32000
					},
					"modalities": {
						"input": ["text", "image", "video"],
						"output": ["text"]
					},
					"reasoning": true,
					"provider": {
						"npm": "@ai-sdk/openai",
						"api": ""
					}
				},
				"gpt-5.3-codex": {
					"limit": {
						"context": 256000,
						"output": 32000
					},
					"modalities": {
						"input": ["text", "image", "video"],
						"output": ["text"]
					},
					"reasoning": true,
					"provider": {
						"npm": "@ai-sdk/openai",
						"api": ""
					}
				},
				"gpt-5.3-codex-spark": {
					"limit": {
						"context": 256000,
						"output": 32000
					},
					"modalities": {
						"input": ["text", "image", "video"],
						"output": ["text"]
					},
					"reasoning": true,
					"provider": {
						"npm": "@ai-sdk/openai",
						"api": ""
					}
				},
				"claude-opus-4.6": {
					"limit": {
						"context": 200000,
						"output": 32000
					},
					"modalities": {
						"input": ["text", "image", "video"],
						"output": ["text"]
					},
					"reasoning": true,
					"provider": {
						"npm": "@ai-sdk/anthropic",
						"api": ""
					}
				},
				"claude-sonnet-4.6": {
					"limit": {
						"context": 200000,
						"output": 32000
					},
					"modalities": {
						"input": ["text", "image", "video"],
						"output": ["text"]
					},
					"reasoning": true,
					"provider": {
						"npm": "@ai-sdk/anthropic",
						"api": ""
					}
				},
				"gemini-3.1-pro-preview": {
					"limit": {
						"context": 200000,
						"output": 32000
					},
					"modalities": {
						"input": ["text", "image", "video"],
						"output": ["text"]
					},
					"reasoning": true,
					"interleaved": {
						"field": "reasoning_content"
					}
				},
				"gemini-3-flash-preview": {
					"limit": {
						"context": 200000,
						"output": 32000
					},
					"modalities": {
						"input": ["text", "image", "video"],
						"output": ["text"]
					},
					"reasoning": true,
					"interleaved": {
						"field": "reasoning_content"
					}
				},
				"glm-5": {
					"limit": {
						"context": 200000,
						"output": 32000
					},
					"reasoning": true,
					"interleaved": {
						"field": "reasoning_content"
					}
				},
				"kimi-k2.5": {
					"limit": {
						"context": 200000,
						"output": 32000
					},
					"reasoning": true,
					"interleaved": {
						"field": "reasoning_content"
					}
				},
				"minimax-m2.5": {
					"limit": {
						"context": 192000,
						"output": 32000
					},
					"reasoning": true,
					"interleaved": {
						"field": "reasoning_content"
					}
				}
			}
		}
	},
	"permission": {
		"edit": "allow",
		"bash": "allow",
		"webfetch": "allow",
		"doom_loop": "allow",
		"external_directory": "allow",
		"skill": {
			"*": "allow"
		}
	},
	"mcp": {
		"tavily-mcp": {
			"enabled": true,
			"type": "local",
			"command": ["npx", "-y", "tavily-mcp@latest"],
			"environment": {
				"TAVILY_API_KEY": "{env:TAVILY_API_KEY}"
			}
		},
		"filesystem": {
			"enabled": true,
			"type": "local",
			"command": [
				"npx",
				"-y",
				"@modelcontextprotocol/server-filesystem",
				"{env:HOME}"
			]
		},
		"github": {
			"enabled": true,
			"type": "local",
			"command": [
				"docker",
				"run",
				"-i",
				"--rm",
				"-e",
				"GITHUB_PERSONAL_ACCESS_TOKEN",
				"-e",
				"GITHUB_TOOLSETS=all",
				"ghcr.io/github/github-mcp-server"
			],
			"environment": {
				"GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
			}
		},
		"chrome-devtools": {
			"enabled": true,
			"type": "local",
			"command": ["npx", "-y", "chrome-devtools-mcp@latest"]
		}
	},
	"plugin": ["oh-my-opencode@latest"]
}
